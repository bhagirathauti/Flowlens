generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(WAREHOUSE_SUPERVISOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  OPERATIONS_MANAGER
  WAREHOUSE_SUPERVISOR
  QA_TEAM
}

model Warehouse {
  id        String          @id @default(uuid())
  name      String
  location  String
  capacity  Int
  isActive  Boolean         @default(true)
  status    WarehouseStatus @default(ACTIVE)
  zones     WarehouseZone[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ZoneType {
  RECEIVING
  PICKING
  PACKING
  QUALITY_CHECK
  DISPATCH
  STORAGE
}

model WarehouseZone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        ZoneType  @default(STORAGE)
  capacity    Int       @default(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
enum Stage {
  ORDER_RECEIVED
  PICKING
  PACKING
  QUALITY_CHECK
  DISPATCH
  DELIVERY
}

enum SLAStatus {
  ON_TIME
  AT_RISK
  BREACHED
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  warehouse        String
  assignedEmployee String
  currentStage     Stage       @default(ORDER_RECEIVED)
  stageTimestamp   DateTime    @default(now())
  processingTime   Int         @default(0)
  slaStatus        SLAStatus   @default(ON_TIME)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  history          StageLogs[]
}

model StageLogs {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  stage          Stage
  changedAt      DateTime @default(now())
  processingTime Int
}